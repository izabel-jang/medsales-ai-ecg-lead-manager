# Google Gemini AI API Key (필수 - STANDARD, DEEP 모드)
VITE_GEMINI_API_KEY=your_api_key_here
# Google Custom Search (선택사항 - 병원 상세 정보 검색용)
VITE_GOOGLE_SEARCH_API_KEY=your_api_key_here
VITE_SEARCH_ENGINE_ID=your_custom_search_engine_id

# News API (선택사항 - 뉴스 검색용)
VITE_NEWS_API_KEY=your_news_api_key

# 사용법:
# 1. 이 파일을 .env로 복사하세요
# 2. API 키들을 실제 값으로 교체하세요
# 3. Google AI Studio에서 Gemini API 키를 발급받으세요: https://aistudio.google.com/
# 4. Perplexity API 키를 발급받으세요: https://www.perplexity.ai/settings/api
# 5. Deep Research 모드를 사용하려면 Gemini 2.0 접근이 필요합니다
# 6. Perplexity 모드는 실시간 웹 검색으로 가장 최신 정보를 제공합니다